RunService:BindToRenderStep(RENDER_BIND_NAME, Enum.RenderPriority.Camera.Value + 1, function()
	local camera = Workspace.CurrentCamera
	if not camera then
		return
	end

	for _, player in ipairs(Players:GetPlayers()) do
		updateEspForPlayer(player)
	end

	updateHitboxes()

	local localCharacter = localPlayer.Character
	local localRoot = localCharacter and localCharacter:FindFirstChild("HumanoidRootPart")
	local localHumanoid = localCharacter and localCharacter:FindFirstChildOfClass("Humanoid")

	if localHumanoid and speedEnabled then
		localHumanoid.WalkSpeed = walkSpeedValue
	end

	if localCharacter then
		updateWeaponReach(localCharacter)

		if localRoot and flyActive then
			updateFlight(localCharacter, localRoot, camera)
		end
	end

	if aimEnabled then
		local originPos = localRoot and localRoot.Position or camera.CFrame.Position
		local targetHead = getClosestPlayerHead(originPos)
		if targetHead then
			camera.CFrame = CFrame.lookAt(camera.CFrame.Position, targetHead.Position)
		end
	end

	if killAuraEnabled then
		if targetPlayer then
			local tch = targetPlayer.Character
			if not tch or not tch:FindFirstChild("Humanoid") or tch.Humanoid.Health <= 0 or hasSpawnProtection(tch) or (tch:FindFirstChild("HumanoidRootPart") and isNearSpawnLocation(tch.HumanoidRootPart)) then
				clearTarget()
			end
		end
		if not targetPlayer then
			setTarget(findNewTarget() or targetPlayer)
		end
	end

	if killAuraEnabled and targetPlayer and targetPlayer.Character and localRoot then
		local tHRP = targetPlayer.Character:FindFirstChild("HumanoidRootPart")
		if tHRP then
			local killAuraOffset = CFrame.new(0, 0, 3.5)
			localRoot.CFrame = tHRP.CFrame * killAuraOffset
			localRoot.Velocity = Vector3.zero
		end
	end
end)

