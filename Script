local function stopFlying()
	local character = localPlayer.Character
	if not character then
		return
	end
	local root = character:FindFirstChild("HumanoidRootPart")
	local humanoid = character:FindFirstChildOfClass("Humanoid")
	if root then
		local bv = root:FindFirstChild("SoloFlyBV")
		if bv then
			bv:Destroy()
		end
		local bg = root:FindFirstChild("SoloFlyBG")
		if bg then
			bg:Destroy()
		end
	end
	if humanoid then
		humanoid.PlatformStand = false
	end
end

local function resetPlayerHitboxes()
	for _, player in ipairs(Players:GetPlayers()) do
		if player ~= localPlayer and player.Character then
			local root = player.Character:FindFirstChild("HumanoidRootPart")
			if root and root:IsA("BasePart") then
				root.Size = defaultRootSize
				root.Transparency = 1
				root.CanCollide = false
			end
		end
	end
end

local function resetWeaponReach()
	for handle, origSize in pairs(originalHandleSizes) do
		if handle and handle.Parent then
			handle.Size = origSize
			local visualBox = handle:FindFirstChild("SoloReachVisual")
			if visualBox then
				visualBox:Destroy()
			end
		end
	end
	originalHandleSizes = {}
end

local function toggleAim()
	aimEnabled = not aimEnabled
	refreshUiState()
end

local function toggleEsp()
	espEnabled = not espEnabled
	for _, highlight in pairs(espHighlights) do
		highlight.Enabled = espEnabled
	end
	refreshUiState()
end

local function toggleFlySubMenu()
	flySubMenuOpen = not flySubMenuOpen
	refreshUiState()
end

local function toggleFlyActive()
	flyActive = not flyActive
	if not flyActive then
		stopFlying()
	end
	refreshUiState()
end

local function toggleHitbox()
	hitboxEnabled = not hitboxEnabled
	if not hitboxEnabled then
		resetPlayerHitboxes()
	end
	refreshUiState()
end

local function toggleReach()
	reachEnabled = not reachEnabled
	if not reachEnabled then
		resetWeaponReach()
	end
	refreshUiState()
end

local function toggleNoclip()
	noclipEnabled = not noclipEnabled
	if not noclipEnabled and localPlayer.Character then
		for _, part in ipairs(localPlayer.Character:GetDescendants()) do
			if part:IsA("BasePart") and (part.Name == "Torso" or part.Name == "UpperTorso" or part.Name == "LowerTorso" or part.Name == "HumanoidRootPart") then
				part.CanCollide = true
			end
		end
	end
	refreshUiState()
end

local function toggleSpeed()
	speedEnabled = not speedEnabled
	if not speedEnabled and localPlayer.Character then
		local humanoid = localPlayer.Character:FindFirstChildOfClass("Humanoid")
		if humanoid then
			humanoid.WalkSpeed = defaultWalkSpeed
		end
	end
	refreshUiState()
end

local function toggleKillAura()
	killAuraEnabled = not killAuraEnabled
	refreshUiState()
end

