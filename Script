RunService:BindToRenderStep(RENDER_BIND_NAME, Enum.RenderPriority.Camera.Value + 1, function()
	local camera = Workspace.CurrentCamera
	if not camera then return end

	for _, player in ipairs(Players:GetPlayers()) do
		updateEspForPlayer(player)
	end

	updateHitboxes()

	local localCharacter = localPlayer.Character
	local localRoot = localCharacter and localCharacter:FindFirstChild("HumanoidRootPart")
	local localHumanoid = localCharacter and localCharacter:FindFirstChildOfClass("Humanoid")

	if localHumanoid and speedEnabled then
		localHumanoid.WalkSpeed = walkSpeedValue
	end

	if localCharacter then
		updateWeaponReach(localCharacter)
		if localRoot then
			if flyActive then updateFlight(localCharacter, localRoot, camera) end
			runKillAuraMethods(localCharacter, localRoot)
		end
	end

	if aimEnabled then
		local originPos = localRoot and localRoot.Position or camera.CFrame.Position
		local targetHead = getClosestPlayerHead(originPos)
		if targetHead then
			camera.CFrame = CFrame.lookAt(camera.CFrame.Position, targetHead.Position)
		end
	end
end)

