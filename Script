local function addSpyLog(direction, remoteObj, argsTable)
	if spyLogCount >= 80 then
		local firstChild = spyScroll:FindFirstChildOfClass("TextBox")
		if firstChild then
			firstChild:Destroy()
			spyLogCount = spyLogCount - 1
		end
	end

	spyLogCount = spyLogCount + 1

	local formattedArgs = {}
	for i = 1, #argsTable do
		local val = argsTable[i]
		if typeof(val) == "string" then
			table.insert(formattedArgs, '"' .. val .. '"')
		elseif typeof(val) == "Instance" then
			table.insert(formattedArgs, val:GetFullName())
		else
			table.insert(formattedArgs, tostring(val))
		end
	end

	local argsString = table.concat(formattedArgs, ", ")
	if #argsString > 100 then
		argsString = string.sub(argsString, 1, 100) .. "..."
	end

	local entry = Instance.new("TextBox")
	entry.Size = UDim2.new(1, -6, 0, 28)
	entry.BackgroundColor3 = Color3.fromRGB(30, 30, 40)
	entry.BorderSizePixel = 0
	entry.TextEditable = false
	entry.ClearTextOnFocus = false
	entry.TextWrapped = true
	entry.TextXAlignment = Enum.TextXAlignment.Left
	entry.TextYAlignment = Enum.TextYAlignment.Center
	entry.Font = Enum.Font.Code
	entry.TextSize = 10
	entry.TextColor3 = direction == "OUT" and Color3.fromRGB(255, 200, 90) or Color3.fromRGB(110, 220, 255)
	entry.Text = string.format("[%s] %s(%s)", direction, remoteObj.Name, argsString)
	entry.LayoutOrder = spyLogCount
	entry.Parent = spyScroll
end

