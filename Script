-- Очистка физики полёта
local function stopFlying()
	local character = localPlayer.Character
	if not character then
		return
	end
	local root = character:FindFirstChild("HumanoidRootPart")
	local humanoid = character:FindFirstChildOfClass("Humanoid")
	if root then
		local bv = root:FindFirstChild("SoloFlyBV")
		if bv then
			bv:Destroy()
		end
		local bg = root:FindFirstChild("SoloFlyBG")
		if bg then
			bg:Destroy()
		end
	end
	if humanoid then
		humanoid.PlatformStand = false
	end
end

-- Переключатели
local function toggleAim()
	aimEnabled = not aimEnabled
	refreshUiState()
end

local function toggleEsp()
	espEnabled = not espEnabled
	for _, highlight in pairs(espHighlights) do
		highlight.Enabled = espEnabled
	end
	refreshUiState()
end

local function toggleFlySubMenu()
	flySubMenuOpen = not flySubMenuOpen
	refreshUiState()
end

local function toggleFlyActive()
	flyActive = not flyActive
	if not flyActive then
		stopFlying()
	end
	refreshUiState()
end

local function toggleKillAura()
	killAuraEnabled = not killAuraEnabled
	refreshUiState()
end

local function toggleNoclip()
	noclipEnabled = not noclipEnabled
	if not noclipEnabled and localPlayer.Character then
		for _, part in ipairs(localPlayer.Character:GetDescendants()) do
			if part:IsA("BasePart") and (part.Name == "Torso" or part.Name == "UpperTorso" or part.Name == "LowerTorso" or part.Name == "HumanoidRootPart") then
				part.CanCollide = true
			end
		end
	end
	refreshUiState()
end

local function toggleSpeed()
	speedEnabled = not speedEnabled
	if not speedEnabled and localPlayer.Character then
		local humanoid = localPlayer.Character:FindFirstChildOfClass("Humanoid")
		if humanoid then
			humanoid.WalkSpeed = defaultWalkSpeed
		end
	end
	refreshUiState()
end

