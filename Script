local function toggleAimPlayer()
	aimPlayerEnabled = not aimPlayerEnabled
	if aimPlayerEnabled then
		aimNpcEnabled = false
	end
	refreshUiState()
end

local function toggleAimNpc()
	aimNpcEnabled = not aimNpcEnabled
	if aimNpcEnabled then
		aimPlayerEnabled = false
	end
	refreshUiState()
end

local function toggleEsp()
	espEnabled = not espEnabled
	for _, highlight in pairs(espHighlights) do
		highlight.Enabled = espEnabled
	end
	refreshUiState()
end

