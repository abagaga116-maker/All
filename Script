-- Проверка, совпадает ли имя модели или её папки с популярными типами NPC
local function matchesNpcKeyword(model)
	local lowerName = string.lower(model.Name)
	local parentName = model.Parent and string.lower(model.Parent.Name) or ""

	for _, keyword in ipairs(NPC_KEYWORDS) do
		if string.find(lowerName, keyword, 1, true) or string.find(parentName, keyword, 1, true) then
			return true
		end
	end
	return false
end

-- Определение целевой части тела (в приоритете Head)
local function getTargetPart(model)
	local head = model:FindFirstChild("Head")
	if head and head:IsA("BasePart") then
		return head
	end
	local fakeHead = model:FindFirstChild("FakeHead") or model:FindFirstChild("HeadHitbox")
	if fakeHead and fakeHead:IsA("BasePart") then
		return fakeHead
	end
	local root = model:FindFirstChild("HumanoidRootPart") or model.PrimaryPart
	if root and root:IsA("BasePart") then
		return root
	end
	return nil
end

-- Проверка и регистрация модели как NPC
local function evaluateNpcModel(model)
	if not model or not model:IsA("Model") then
		return
	end
	if Players:GetPlayerFromCharacter(model) then
		return
	end
	local humanoid = model:FindFirstChildOfClass("Humanoid")
	if not humanoid then
		return
	end
	if matchesNpcKeyword(model) or humanoid.Health > 0 then
		trackedNpcs[model] = humanoid
	end
end

-- Инициализация существующих NPC на карте
for _, descendant in ipairs(Workspace:GetDescendants()) do
	if descendant:IsA("Humanoid") and descendant.Parent and descendant.Parent:IsA("Model") then
		evaluateNpcModel(descendant.Parent)
	end
end

Workspace.DescendantAdded:Connect(function(descendant)
	if descendant:IsA("Humanoid") and descendant.Parent and descendant.Parent:IsA("Model") then
		evaluateNpcModel(descendant.Parent)
	elseif descendant:IsA("Model") then
		evaluateNpcModel(descendant)
	end
end)

Workspace.DescendantRemoving:Connect(function(descendant)
	if trackedNpcs[descendant] then
		trackedNpcs[descendant] = nil
	end
end)

local function isPlayerTargetValid(player)
	if player == localPlayer then
		return false
	end
	local character = player.Character
	if not character then
		return false
	end
	local head = getTargetPart(character)
	local humanoid = character:FindFirstChildOfClass("Humanoid")
	if not head or not humanoid or humanoid.Health <= 0 then
		return false
	end
	return true
end

-- Поиск ближайшего живого игрока
local function getClosestPlayerHead(originPosition)
	local closestPart = nil
	local shortestDistance = math.huge

	for _, player in ipairs(Players:GetPlayers()) do
		if isPlayerTargetValid(player) then
			local part = getTargetPart(player.Character)
			local distance = (part.Position - originPosition).Magnitude
			if distance < shortestDistance then
				shortestDistance = distance
				closestPart = part
			end
		end
	end

	return closestPart
end

-- Поиск ближайшего живого NPC (с приоритетом по популярным именам и проверкой жизни)
local function getClosestNpcHead(originPosition)
	local closestPart = nil
	local shortestDistance = math.huge

	for model, humanoid in pairs(trackedNpcs) do
		if not model or not model.Parent or Players:GetPlayerFromCharacter(model) then
			trackedNpcs[model] = nil
		else
			if humanoid and humanoid.Parent == model and humanoid.Health > 0 then
				local part = getTargetPart(model)
				if part then
					local distance = (part.Position - originPosition).Magnitude
					if distance < shortestDistance then
						shortestDistance = distance
						closestPart = part
					end
				end
			end
		end
	end

	return closestPart
end

